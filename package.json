{
  "name": "agy-hub",
  "version": "0.4.0",
  "description": "A configurable status line for Antigravity CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JS-banana/agy-hub.git"
  },
  "bugs": {
    "url": "https://github.com/JS-banana/agy-hub/issues"
  },
  "type": "module",
  "bin": {
    "agy-hub": "src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "node src/cli.js preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "test:package": "node scripts/package-smoke.js",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "check": "npm run typecheck && npm test && npm run test:package"
  },
  "files": [
    "src/",
    "README.zh.md",
    "docs/integration.md",
    "docs/architecture.md",
    "skills/agy-hub/SKILL.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
