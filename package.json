{
  "name": "agy-hub",
  "version": "0.3.0",
  "description": "A Claude HUD-style status line for Antigravity CLI",
  "type": "module",
  "bin": {
    "agy-hub": "src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "node src/cli.js preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "test:package": "node scripts/package-smoke.js",
    "check": "npm run typecheck && npm test && npm run test:package"
  },
  "files": [
    "src/",
    "docs/parity.md",
    "docs/architecture.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
