{
  "name": "agy-hud",
  "version": "0.5.0",
  "description": "A configurable status line for Antigravity CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JS-banana/agy-hud.git"
  },
  "bugs": {
    "url": "https://github.com/JS-banana/agy-hud/issues"
  },
  "homepage": "https://github.com/JS-banana/agy-hud#readme",
  "keywords": [
    "antigravity",
    "agy",
    "statusline",
    "hud",
    "cli",
    "terminal"
  ],
  "type": "module",
  "bin": {
    "agy-hud": "src/cli.js",
    "agy-hub": "src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "node src/cli.js preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "test:package": "node scripts/package-smoke.js",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "check": "npm run typecheck && npm test && npm run test:package"
  },
  "files": [
    "src/",
    "README.zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/assets/agy-hud-terminal-preview.png",
    "docs/configuration.md",
    "docs/integration.md",
    "docs/architecture.md",
    "skills/agy-hud/SKILL.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
